# Environment Configuration
NODE_ENV=development
PORT=5000

# MongoDB Configuration
# Local:      mongodb://localhost:27017/noteapp
# Atlas:      mongodb+srv://<user>:<password>@cluster.mongodb.net/noteapp
MONGODB_URI=your_mongodb_uri_here

# JWT Configuration
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_minimum_32_chars

# Authentication
# The single password used to access this app
SPECIAL_PASSWORD=your_app_password_here

# Frontend URL (for CORS) — set to your Vercel domain in production
FRONTEND_URL=http://localhost:3000
